{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-agent-workbench.local/schemas/blind-routing-candidate-line.json",
  "title": "Blind routing candidate JSONL line",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "language",
    "task",
    "deidentified",
    "reviewedByHuman"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "language": {
      "enum": ["en", "zh", "mixed", "other"]
    },
    "task": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "deidentified": {
      "const": true
    },
    "reviewedByHuman": {
      "const": true
    }
  }
}
