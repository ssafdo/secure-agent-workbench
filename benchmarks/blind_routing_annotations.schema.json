{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secure-agent-workbench.local/schemas/blind-routing-annotations.json",
  "title": "Blind routing reviewer annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "candidateSha256", "reviewerId", "labels"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "secure-agent-workbench/blind-routing-annotations"
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewerId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "expectedSpecialist", "errorCost"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
          },
          "category": {
            "enum": [
              "evidence",
              "unsupported",
              "question",
              "synthesis",
              "comparison",
              "conflict",
              "default",
              "adversarial",
              "other"
            ]
          },
          "expectedSpecialist": {
            "enum": ["retrieval", "synthesis"]
          },
          "errorCost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          }
        }
      }
    }
  }
}
