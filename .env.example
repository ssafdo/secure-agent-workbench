# Replace this value outside development. Do not commit the real secret.
AGENT_WORKBENCH_SECRET=replace-with-at-least-32-random-characters
AGENT_WORKBENCH_ROOT=runtime

# Optional hosted engine. Keep the real key outside source control.
AGENT_WORKBENCH_MODEL_API_KEY=
AGENT_WORKBENCH_MODEL=
AGENT_WORKBENCH_MODEL_BASE_URL=https://api.openai.com/v1
AGENT_WORKBENCH_MODEL_TIMEOUT_SECONDS=30

# DeepSeek Responses API alternative. Select it explicitly; do not commit the key.
# Current official model IDs include deepseek-flash and deepseek-v4-pro.
AGENT_WORKBENCH_MODEL_PROVIDER=responses
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional checksum-pinned local hybrid retrieval. Run the download script first.
# Request handling never downloads a model.
AGENT_WORKBENCH_EMBEDDING_MODEL_PATH=runtime/models/potion-multilingual-128M-i8
